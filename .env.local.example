# Copy this file to .env.local and fill in your credentials
# Supabase values: https://supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# This key bypasses all security - ONLY used in server-side API routes, never in browser code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret for the Skool->Zapier webhook (also set in the Zapier header)
SKOOL_WEBHOOK_SECRET=generate-a-long-random-string

# GoHighLevel inbound webhook (workflow: Inbound Webhook trigger → Create/Update Contact).
# Every new signup's email (+ name after onboarding) is POSTed here.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-webhook-id

# Resend (welcome emails + Supabase SMTP)
RESEND_API_KEY=re_your-key

# Public URL of the deployed app (used in emails)
NEXT_PUBLIC_APP_URL=https://mindfit.academy

# Anthropic (AI-generated training programs)
ANTHROPIC_API_KEY=sk-ant-your-key
