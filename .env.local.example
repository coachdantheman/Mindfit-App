# Copy this file to .env.local and fill in your credentials
# Supabase values: https://supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# This key bypasses all security - ONLY used in server-side API routes, never in browser code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret for the Skool->Zapier webhook (also set in the Zapier header)
SKOOL_WEBHOOK_SECRET=generate-a-long-random-string

# GoHighLevel inbound webhook (workflow: Inbound Webhook trigger → Create/Update Contact).
# Every new signup's email (+ name after onboarding) is POSTed here.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-webhook-id

# Resend (welcome emails + Supabase SMTP)
RESEND_API_KEY=re_your-key

# Public URL of the deployed app (used in emails)
NEXT_PUBLIC_APP_URL=https://mindfit.academy

# Anthropic (AI-generated training programs)
ANTHROPIC_API_KEY=sk-ant-your-key

# Web push for the daily quote notification. Generate once with
# `npx web-push generate-vapid-keys` and paste both keys here AND in Vercel.
# The public key is safe to ship to the browser; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:daniel@mindfit.academy

# Protects /api/cron/daily-quote. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
# on scheduled runs automatically once the env var exists. Any long random string.
CRON_SECRET=generate-a-long-random-string

# Signs the unsubscribe links in emails. Any long random string.
UNSUBSCRIBE_SECRET=

# iPhone app push (Apple Developer → Keys → create a key with "Apple Push Notifications service").
# APNS_PRIVATE_KEY is the contents of the .p8 file, with line breaks written as \n.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
